# BBS Door Server Port Configuration
# Change these if you have port collisions or are testing side-by-side

# RLogin port for BBS connections (Standard: 513, Alternative: 5130 or 5131)
DOOR_PORT=513

# Web-based Sysop desktop interface via noVNC (Default: 6080)
VNC_WEB_PORT=6080

# Debug terminal port for testing door launches (Default: 1234)
DEBUG_PORT=1234

# Timezone
TZ=America/New_York
